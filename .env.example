# Handsfree Environment Configuration Template
# Copy this file to .env and configure the necessary keys.
# Deterministic commands and offline vision work WITHOUT any API keys.

# AI Model Provider Selection
# Options: "none" (deterministic only), "gemini", "openai", "claude", "ollama", "groq"
HANDSFREE_AI_PROVIDER=none

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (or OpenAI-compatible providers)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Groq Cloud API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Local Service Endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Bridge & IPC Configuration
HANDSFREE_BRIDGE_HOST=127.0.0.1
HANDSFREE_BRIDGE_PORT=8765
HANDSFREE_IPC_PIPE_NAME=\\.\\pipe\\handsfree-ipc

# Hardware / Sensor Indexes
HANDSFREE_CAMERA_INDEX=0
HANDSFREE_MIC_INDEX=0

# Logging Level (trace, debug, info, warn, error)
RUST_LOG=info
